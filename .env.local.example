NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
AUTH_SECRET=
API_SECRET=
DASHBOARD_PASSWORD=
ACCOUNTS_ENCRYPTION_KEY=

# ── Shopee Open Platform ─────────────────────────────────────────────────────
# App "Gameshare Code Sharing System", category Seller In House System.
# The app has BOTH a test and a live partner id/key pair. Only ONE pair is
# active at a time: set the pair below to match SHOPEE_ENV. Mixing a live key
# with SHOPEE_ENV=sandbox (or vice versa) fails signature checks against a host
# that never saw that key, and the error Shopee returns does not say so.
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
# "sandbox" (default when unset) or "live". Drives BOTH the auth host and the
# API host in lib/shopee-auth.ts, lib/shopee-api.ts and lib/shopee-chat.ts.
SHOPEE_ENV=
# Override only if the Console's own sandbox auth link uses a different host
# than lib/shopee-auth.ts defaults to — see that file's comment.
SHOPEE_AUTH_HOST=
# Override the API host for shop-scoped calls. Normally unset; SHOPEE_ENV picks
# the right one. Exists so a host change can be fixed without a redeploy.
SHOPEE_API_HOST=
# Must exactly match the callback URL registered in Console > Push Mechanism
# > Set Push. Required for /api/webhooks/shopee's signature check to pass —
# the HMAC base string is `<this exact string>|<raw request body>`.
#
# ⚠ USE THE www HOST. gameshare.space 308-redirects to www.gameshare.space
# (verified 2026-09-05). Shopee POSTs the push and does not follow redirects,
# so registering the apex domain makes every push fail, retry 3x, then get
# dropped — with no order row ever written. Correct value:
#   https://www.gameshare.space/api/webhooks/shopee
SHOPEE_PUSH_CALLBACK_URL=

# Kill switch for automated fulfilment. The webhook only logs pushes unless
# this is EXACTLY the string "true". Leave false until migrations 0005, 0007
# and 0008 are applied — the write path references columns they add.
SHOPEE_AUTO_FULFILL=false

# Seller Chat API paths. Both UNVERIFIED — lib/shopee-chat.ts refuses to send
# while the send path is unset rather than guessing an endpoint. Leave blank
# until a real send has been observed; delivery degrades to "order recorded,
# buyer redeems with the Order ID Shopee already gave them", which is fine.
SHOPEE_SELLERCHAT_SEND_PATH=
SHOPEE_SELLERCHAT_RECIPIENT_PATH=

# ── Post-delivery follow-up (nightly cron) ───────────────────────────────────
# Kill switch for the "press Order Received + leave a rating" message that goes
# out ~24h after delivery. /api/cron/follow-up sends nothing unless this is
# EXACTLY the string "true". Leave false until migration 0009 is applied — the
# job reads columns it adds (it degrades to a named error, but it will not run).
# ⚠ Vercel bakes env vars into a deployment: flipping this needs a redeploy too.
SHOPEE_FOLLOW_UP=false

# Authenticates Vercel's cron invoker. Any long random string. When it is set,
# Vercel sends `Authorization: Bearer <this>` on every scheduled invocation of
# the paths in vercel.json. /api/cron/follow-up answers 503 while it is unset,
# rather than running unauthenticated. Not needed locally — x-api-secret
# (API_SECRET) works for a manual run.
CRON_SECRET=
